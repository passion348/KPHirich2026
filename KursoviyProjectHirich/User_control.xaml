<Window x:Class="KursoviyProjectHirich.User_control"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизація" Height="600" Width="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="MediumPurple">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вхід у систему" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Email:" Foreground="White" Margin="0,5,0,2"/>
            <TextBox x:Name="LoginEmailTxt" Padding="6" FontSize="14"/>

            <TextBlock Text="Пароль:" Foreground="White" Margin="0,10,0,2"/>
            <PasswordBox x:Name="LoginPasswordTxt" Padding="6" FontSize="14"/>

            <Button Content="Увійти" Height="38" Margin="0,20,0,10" FontSize="14" FontWeight="SemiBold" Click="LoginButton_Click"/>
            <Button Content="Немає акаунту? Зареєструватися" Background="Transparent" BorderThickness="0" Foreground="White" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>