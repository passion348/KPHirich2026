<Window x:Class="KursoviyProjectHirich.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Height="600" Width="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="MediumPurple">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Реєстрація" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Ім'я:" Foreground="White" Margin="0,5,0,2"/>
            <TextBox x:Name="RegNameTxt" Padding="6" FontSize="14"/>

            <TextBlock Text="Email:" Foreground="White" Margin="0,10,0,2"/>
            <TextBox x:Name="RegEmailTxt" Padding="6" FontSize="14"/>

            <TextBlock Text="Пароль:" Foreground="White" Margin="0,10,0,2"/>
            <PasswordBox x:Name="RegPasswordTxt" Padding="6" FontSize="14"/>

            <TextBlock Text="Пароль:" Foreground="White" Margin="0,10,0,2"/>
            <PasswordBox x:Name="RegConfirmPasswordTxt" Padding="6" FontSize="14"/>

            <Button Content="Створити акаунт" Height="38" Margin="0,20,0,10" FontSize="14" FontWeight="SemiBold" Click="BtnRegister_Click"/>
            <Button Content="Вже є акаунт? Увійти" Background="Transparent" BorderThickness="0" Foreground="White" Click="BtnBackToLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>